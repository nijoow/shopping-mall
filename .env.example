# Existing .env.local should be preserved. No real secrets belong in this file.
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3100
AUTH_TRUST_HOST=true
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: absolute path to a development database on persistent local storage.
# NIJOOW_DEMO_DB_PATH=

# Cloud PostgreSQL: recommended for Cloud development and required for serverless persistence.
# Local development without this variable continues to use SQLite.
NIJOOW_POSTGRES_URL=
# Vercel also accepts its existing POSTGRES_URL when NIJOOW_POSTGRES_URL is absent.
# Run yarn db:setup once against the selected database before serving requests.
