{
  "name": "nijoow-editorial-store",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint src tests scripts playwright.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/commerce.test.ts tests/model-version.test.ts tests/client-api.test.ts tests/data-operations.test.ts",
    "assets:build": "/Applications/Blender.app/Contents/MacOS/Blender --background --python scripts/build-assets.py",
    "test:http": "node scripts/test-http.mjs",
    "db:setup": "node --import tsx scripts/setup-demo-database.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "assets:check": "node --import tsx scripts/check-assets.ts",
    "check": "yarn typecheck && yarn lint && yarn test && yarn assets:check",
    "check:full": "yarn check && yarn build && yarn test:http && yarn test:browser",
    "test:browser": "playwright test",
    "data:cleanup": "node --import tsx scripts/demo-data.ts cleanup",
    "data:backup": "node --import tsx scripts/demo-data.ts backup",
    "data:restore": "node --import tsx scripts/demo-data.ts restore"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.6.2",
    "tsx": "4.23.13",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.0.2"
}
