    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.19.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
